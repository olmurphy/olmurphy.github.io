---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { FEATURES } from "@config/features";
import { getContent } from "@data";
import { getLocaleStaticPaths, type Locale } from "@i18n/config";
import { UI } from "@i18n/ui";
import CourseItem from "@components/sections/teaching/CourseItem.astro";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const content = getContent(lang).teaching;
const labels = UI[lang].labels;
const currentCourses = content.courses.filter((c) => c.status === "Current");
const previousCourses = content.courses.filter((c) => c.status === "Completed");
---

<BaseLayout
  lang={lang}
  title={lang === "en" ? `Teaching — ${SITE.name}` : `教学经历 — ${SITE.name}`}
  description={
    lang === "en"
      ? "Classes I'm teaching now and classes I've taught in the past."
      : "目前任教及曾经教授过的课程。"
  }
>
  {!FEATURES.showTeachingPage && (
    <meta slot="head" name="robots" content="noindex" />
  )}

  <h1>{content.title}</h1>
  <p class="muted">{content.subtitle}</p>

  {currentCourses.length > 0 && (
    <>
      <h2>{labels.currentlyTeaching}</h2>
      {currentCourses.map((course) => (
        <CourseItem course={course} />
      ))}
    </>
  )}

  {previousCourses.length > 0 && (
    <>
      <h2>{labels.previouslyTaught}</h2>
      {previousCourses.map((course) => (
        <CourseItem course={course} />
      ))}
    </>
  )}
</BaseLayout>
