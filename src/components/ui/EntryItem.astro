---
interface Props {
  title: string;
  meta?: string;
  date?: string;
  dateTodo?: boolean;
  logoSrc?: string;
  logoAlt?: string;
  logoHref?: string;
}

const {
  title,
  meta,
  date,
  dateTodo,
  logoSrc,
  logoAlt = "",
  logoHref,
} = Astro.props;
---

<article
  class:list={[
    "entry",
    { "has-logo": Boolean(logoSrc), "has-date": Boolean(date) },
  ]}
>
  {logoSrc && (
    <div class="logo-wrap">
      {logoHref ? (
        <a
          href={logoHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={logoAlt}
          class="logo-link"
        >
          <img src={logoSrc} alt={logoAlt} width="38" height="38" />
        </a>
      ) : (
        <img src={logoSrc} alt={logoAlt} width="38" height="38" />
      )}
    </div>
  )}

  <div class="entry-body">
    <h3>{title}</h3>
    {(meta || date || Astro.slots.has("meta")) && (
      <div class="meta">
        {meta}
        <slot name="meta" />
        {date && (
          <span class:list={["date-inline", { todo: dateTodo }]}>
            {" "}
            · {date}
          </span>
        )}
      </div>
    )}
    <slot />
  </div>
  {date && <div class:list={["date", { todo: dateTodo }]}>{date}</div>}
</article>

<style>
  .entry {
    margin-bottom: 22px;
  }

  .entry.has-logo {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .entry.has-date {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "body date";
    column-gap: 16px;
  }

  .entry.has-date.has-logo {
    grid-template-columns: 42px minmax(0, 1fr) auto;
    grid-template-areas: "logo body date";
  }

  .logo-wrap {
    width: 42px;
    height: 42px;
    margin-top: 2px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: #ffffff;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border: none;
  }

  .logo-link:hover {
    border: none;
  }

  .logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2px;
  }

  .logo-fallback {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry.has-date .entry-body {
    grid-area: body;
  }

  .entry.has-date .logo-wrap {
    grid-area: logo;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }

  .date {
    grid-area: date;
    padding-top: 4px;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    text-align: right;
    white-space: nowrap;
  }

  .date-inline {
    display: none;
  }

  @media (max-width: 640px) {
    .entry.has-date {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "body";
    }

    .entry.has-date.has-logo {
      grid-template-columns: 42px minmax(0, 1fr);
      grid-template-areas: "logo body";
    }

    .date {
      display: none;
    }

    .date-inline {
      display: inline;
    }
  }
</style>
