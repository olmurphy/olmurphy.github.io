---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { getContent } from "@data";
import { getLocaleStaticPaths, type Locale } from "@i18n/config";
import VisitedMap from "@components/sections/places/VisitedMap.astro";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const content = getContent(lang).places;
---

<BaseLayout
  lang={lang}
  title={
    lang === "en" ? `Places — ${SITE.name}` : `${content.title} — ${SITE.name}`
  }
  description={content.subtitle}
>
  <h1>{content.title}</h1>
  <p class="muted">{content.subtitle}</p>

  <VisitedMap content={content} />
</BaseLayout>
