---
import { getContent } from "@data";
import { getLocaleFromPath, localePath } from "@i18n/utils";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang);
---

<section aria-labelledby="research-interests-heading">
  <h2 id="research-interests-heading">
    {content.home.researchOverview.heading}
  </h2>
  <p>{content.home.researchOverview.intro}</p>
  <ul>
    {content.home.researchOverview.pillars.map((pillar) => (
      <li>
        <strong>{pillar.title}:</strong> {pillar.description}
      </li>
    ))}
  </ul>
  <p class="small">
    <a href={localePath(lang, content.home.researchOverview.moreHref)}>
      {content.home.researchOverview.moreLabel}
    </a>
  </p>
</section>
