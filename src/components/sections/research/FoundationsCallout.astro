---
import { getContent } from "@data";
import { getLocaleFromPath, localePath } from "@i18n/utils";
import { UI } from "@i18n/ui";
import Callout from "@components/ui/Callout.astro";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang).research;
const labels = UI[lang].labels;
---

<section
  aria-label={
    lang === "en"
      ? "Mathematical foundations and collaboration"
      : labels.foundations
  }
>
  <h2>{labels.foundations}</h2>
  <p>{content.foundations}</p>

  <Callout>
    <strong>{labels.prospectiveCollaborators}</strong>{" "}
    {lang === "en"
      ? "I'm happy to talk about research. "
      : "欢迎交流研究相关问题。 "}
    <a href={localePath(lang, "/contact")}>{labels.getInTouch}</a>
  </Callout>
</section>
