---
interface Props {
  title: string;
  meta?: string;
}

const { title, meta } = Astro.props;
---

<article class="entry">
  <h3>{title}</h3>
  {(meta || Astro.slots.has("meta")) && (
    <div class="meta">
      {meta}
      <slot name="meta" />
    </div>
  )}
  <slot />
</article>

<style>
  .entry {
    margin-bottom: 22px;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }
</style>
