---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { FEATURES } from "@config/features";
import { TEACHING_CONTENT } from "@data/teaching";
import CourseItem from "@components/sections/teaching/CourseItem.astro";

const currentCourses = TEACHING_CONTENT.courses.filter(
  (c) => c.status === "Current",
);
const previousCourses = TEACHING_CONTENT.courses.filter(
  (c) => c.status === "Completed",
);
---

<BaseLayout
  title={`Teaching — ${SITE.name}`}
  description="Classes I'm teaching now and classes I've taught in the past."
>
  {!FEATURES.showTeachingPage && (
    <meta slot="head" name="robots" content="noindex" />
  )}

  <h1>{TEACHING_CONTENT.title}</h1>
  <p class="muted">{TEACHING_CONTENT.subtitle}</p>

  {currentCourses.length > 0 && (
    <>
      <h2>Currently teaching</h2>
      {currentCourses.map((course) => (
        <CourseItem course={course} />
      ))}
    </>
  )}

  {previousCourses.length > 0 && (
    <>
      <h2>Previously taught</h2>
      {previousCourses.map((course) => (
        <CourseItem course={course} />
      ))}
    </>
  )}
</BaseLayout>
