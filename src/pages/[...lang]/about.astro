---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { buildAboutJsonLd } from "@data/schema";
import { getContent } from "@data";
import { getLocaleStaticPaths, type Locale } from "@i18n/config";
import BioNarrative from "@components/sections/about/BioNarrative.astro";
import PersonalLife from "@components/sections/about/PersonalLife.astro";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const content = getContent(lang).about;
---

<BaseLayout
  lang={lang}
  title={lang === "en" ? `About — ${SITE.name}` : content.meta.title}
  description={content.meta.description}
  jsonLd={buildAboutJsonLd(lang)}
>
  <h1>{content.title}</h1>
  <p class="muted">{content.subtitle}</p>

  <BioNarrative />
  <PersonalLife />
</BaseLayout>
