---
import { getLocaleFromPath } from "@i18n/utils";

const lang = getLocaleFromPath(Astro.url.pathname);
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label={lang === "en" ? "Photo viewer" : "照片浏览器"}
  hidden
>
  <button
    type="button"
    class="lb-close"
    id="lb-close"
    aria-label={lang === "en" ? "Close photo" : "关闭照片"}
  >
    ×
  </button>

  <button
    type="button"
    class="lb-nav lb-prev"
    id="lb-prev"
    aria-label={lang === "en" ? "Previous photo" : "上一张照片"}
  >
    ‹
  </button>

  <img id="lb-img" src="" alt="" />
  <div class="lb-cap" id="lb-cap"></div>

  <button
    type="button"
    class="lb-nav lb-next"
    id="lb-next"
    aria-label={lang === "en" ? "Next photo" : "下一张照片"}
  >
    ›
  </button>
</div>

<style>
  [hidden] {
    display: none !important;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    padding: 24px 56px;
    cursor: zoom-out;
    background: rgba(10, 12, 14, 0.88);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .lightbox img {
    max-width: min(92vw, 1100px);
    max-height: 78vh;
    border-radius: 6px;
    cursor: default;
  }

  .lb-cap {
    color: #e6e8ea;
    margin-top: 14px;
    text-align: center;
    font-size: 0.95rem;
    max-width: 640px;
    cursor: default;
  }

  .lb-close,
  .lb-nav {
    position: absolute;
    background: none;
    border: none;
    color: #e6e8ea;
    cursor: pointer;
    opacity: 0.78;
    transition: opacity var(--transition-fast);
  }

  .lb-close:hover,
  .lb-nav:hover,
  .lb-close:focus-visible,
  .lb-nav:focus-visible {
    opacity: 1;
  }

  .lb-close {
    top: 14px;
    right: 18px;
    font-size: 1.8rem;
    line-height: 1;
    padding: 4px 8px;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 2.4rem;
    line-height: 1;
    padding: 12px 14px;
    user-select: none;
  }

  .lb-prev {
    left: 10px;
  }

  .lb-next {
    right: 10px;
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: 24px 16px;
    }

    .lb-nav {
      font-size: 2rem;
      padding: 8px 10px;
    }

    .lb-prev {
      left: 4px;
    }

    .lb-next {
      right: 4px;
    }
  }
</style>
