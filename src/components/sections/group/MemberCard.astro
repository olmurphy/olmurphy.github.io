---
import type { GroupMember } from "@data/group";
import { getLocaleFromPath } from "@i18n/utils";
import EntryItem from "@components/ui/EntryItem.astro";

interface Props {
  member: GroupMember;
}

const { member } = Astro.props;
const lang = getLocaleFromPath(Astro.url.pathname);
const metaParts = [
  member.period,
  member.coAdvisor
    ? `${lang === "en" ? "Co-advised with" : "共同指导教师"} ${member.coAdvisor}`
    : undefined,
].filter(Boolean);
---

<EntryItem title={member.name} meta={metaParts.join(" · ")}>
  <p class="small">
    {member.researchFocus}
    {member.nextPosition && (
      <span class="muted">
        {" "}
        · {lang === "en" ? "Next:" : "后续去向："} {member.nextPosition}
      </span>
    )}
    {member.website && (
      <>
        {" "}
        ·{" "}
        <a href={member.website}>
          {lang === "en" ? "Website →" : "个人主页 →"}
        </a>
      </>
    )}
  </p>
</EntryItem>
