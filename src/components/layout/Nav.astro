---
import { NAV_GROUPS, NAV_ITEMS } from "@config/site";
import { FEATURES } from "@config/features";
import ThemeToggle from "./ThemeToggle.astro";

const normalize = (path: string) =>
  path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;

const currentPath = normalize(Astro.url.pathname);
const visibleNavItems = NAV_ITEMS.filter(
  (item) => !item.featureFlag || FEATURES[item.featureFlag],
);

const groupedNavItems = NAV_GROUPS.map((group) => ({
  label: group,
  items: visibleNavItems.filter((item) => item.group === group),
})).filter((group) => group.items.length > 0);
---

<!-- Desktop only: original full tab row -->
<nav class="desktop-nav" aria-label="Primary navigation">
  {visibleNavItems.map((item) => {
    const isActive = currentPath === normalize(item.href);
    return (
      <a
        href={item.href}
        class:list={[{ active: isActive }]}
        aria-current={isActive ? "page" : undefined}
      >
        {item.label}
      </a>
    );
  })}
  <div class="desktop-toggle">
    <ThemeToggle />
  </div>
</nav>

<!-- Mobile only: grouped drop-down drawer -->
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
  <div class="wrap menu-inner">
    {groupedNavItems.map((group) => (
      <div class="group">
        <div class="group-label">{group.label}</div>
        {group.items.map((item) => {
          const isActive = currentPath === normalize(item.href);
          return (
            <a
              href={item.href}
              class:list={[{ active: isActive }]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    ))}

    <div class="menu-foot">
      <span>Appearance</span>
      <ThemeToggle />
    </div>
  </div>
</nav>

<style>
  .desktop-nav {
    display: none;
  }

  /* ---------- Mobile drop-down panel ---------- */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    max-height: calc(100vh - var(--header-height));
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  .mobile-menu.open {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .menu-inner {
    padding-top: 6px;
    padding-bottom: 18px;
  }

  .group-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 16px 0 4px;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 1.02rem;
  }

  .mobile-menu a::after {
    content: "›";
    color: var(--color-text-muted);
    font-size: 1.2rem;
    line-height: 1;
  }

  .mobile-menu a:hover {
    color: var(--color-accent);
  }

  .mobile-menu a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .mobile-menu a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .mobile-menu a.active::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .mobile-menu .group a:last-child {
    border-bottom: none;
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ---------- Desktop tab row ---------- */
  @media (min-width: 760px) {
    .mobile-menu {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
    }

    .desktop-nav a {
      color: var(--color-text-muted);
      padding: 8px 0 10px;
      border-bottom: 2px solid transparent;
    }

    .desktop-nav a:hover {
      color: var(--color-text);
      border-bottom-color: var(--color-border);
    }

    .desktop-nav a.active {
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
      font-weight: 600;
    }

    .desktop-toggle {
      margin-left: auto;
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>
