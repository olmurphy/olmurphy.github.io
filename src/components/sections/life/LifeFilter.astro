---
import type { LifeCategoryMeta } from "@data/life";
import { getLocaleFromPath } from "@i18n/utils";

interface Props {
  categories: readonly LifeCategoryMeta[];
}

const { categories } = Astro.props;
const lang = getLocaleFromPath(Astro.url.pathname);
---

<div
  class="filters"
  id="life-filters"
  role="group"
  aria-label={lang === "en" ? "Filter photos by category" : "按类别筛选照片"}
>
  <button type="button" class="chip on" data-filter="all" aria-pressed="true">
    {lang === "en" ? "All" : "全部"}
  </button>
  {categories.map((cat) => (
    <button
      type="button"
      class="chip"
      data-filter={cat.id}
      aria-pressed="false"
    >
      {cat.label}
    </button>
  ))}
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
    font-family: var(--font-sans);
  }

  .chip {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-pill);
    padding: 3px 12px;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .chip:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .chip.on {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: transparent;
    font-weight: 600;
  }
</style>
