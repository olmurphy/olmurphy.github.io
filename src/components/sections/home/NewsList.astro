---
import type { NewsItem } from "@data/types";
import { getContent } from "@data";
import { getLocaleFromPath } from "@i18n/utils";

interface Props {
  items: readonly NewsItem[];
}

const { items } = Astro.props;
const lang = getLocaleFromPath(Astro.url.pathname);
const heading = getContent(lang).home.newsHeading;
---

<section aria-labelledby="news-heading">
  <h2 id="news-heading">{heading}</h2>
  <ul class="news">
    {items.map((item) => (
      <li>
        <span class="date">{item.date}</span>
        <span>{item.text}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .news li {
    list-style: none;
    margin-left: -20px;
    display: flex;
    gap: 14px;
  }

  .date {
    color: var(--color-text-muted);
    min-width: 78px;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    padding-top: 2px;
  }
</style>
