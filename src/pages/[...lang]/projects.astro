---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { FEATURES } from "@config/features";
import { getContent } from "@data";
import type { ProjectEntry } from "@data/projects";
import { buildProjectsJsonLd } from "@data/schema";
import { getLocaleStaticPaths, type Locale } from "@i18n/config";
import { UI } from "@i18n/ui";
import ProjectCard from "@components/sections/projects/ProjectCard.astro";
import TodoNote from "@components/ui/TodoNote.astro";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const content = getContent(lang).projects;
const labels = UI[lang].labels;

const isVisible = (entry: ProjectEntry) =>
  !entry.featureFlag || FEATURES[entry.featureFlag];

const visibleProjects = content.projects.filter(isVisible);
const visibleHackathons = content.hackathons.filter(isVisible);
---

<BaseLayout
  lang={lang}
  title={lang === "en" ? `Projects — ${SITE.name}` : `项目 — ${SITE.name}`}
  description={
    lang === "en"
      ? "Research and software engineering projects by Owen Li Murphy."
      : "Owen Li Murphy 的研究与软件工程项目。"
  }
  jsonLd={buildProjectsJsonLd(lang)}
>
  <h1>{content.title}</h1>
  <p class="muted">{content.subtitle}</p>

  <h2 class="first-heading">{labels.projects}</h2>
  {visibleProjects.map((project) => (
    <ProjectCard project={project} />
  ))}

  <h2>{labels.hackathons}</h2>
  {visibleHackathons.map((hackathon) => (
    <ProjectCard project={hackathon} />
  ))}
  <p class="small muted">
    <TodoNote>{content.hackathonPromptTodo}</TodoNote>
  </p>

  <p class="small muted">
    {lang === "en"
      ? "Tip: pick your 3–5 best and give each a one-line takeaway, plus a link to code or a write-up. For a research portfolio, quality and clarity matter more than quantity."
      : "建议精选 3–5 个代表项目，为每个项目写一句总结，并附上代码或说明文档链接。研究作品集重在质量与清晰度，而非数量。"}
  </p>
</BaseLayout>

<style>
  .first-heading {
    margin-top: 22px;
  }
</style>
