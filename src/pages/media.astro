---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { MEDIA_CONTENT } from "@data/media";
import { buildMediaJsonLd } from "@data/schema";
import FeaturedTalkCard from "@components/sections/media/FeaturedTalkCard.astro";
import Card from "@components/ui/Card.astro";
import EntryItem from "@components/ui/EntryItem.astro";
import Tag from "@components/ui/Tag.astro";
import TodoNote from "@components/ui/TodoNote.astro";
---

<BaseLayout
  title={`Media — ${SITE.name}`}
  description="Educational videos, viral talks, and science communication by Owen Li Murphy."
  jsonLd={buildMediaJsonLd()}
>
  <h1>{MEDIA_CONTENT.title}</h1>
  <p class="muted">{MEDIA_CONTENT.subtitle}</p>

  <h2>Featured Talks &amp; Presentations</h2>
  {MEDIA_CONTENT.featuredTalks.map((talk) => (
    <FeaturedTalkCard talk={talk} />
  ))}

  <h2>Series</h2>
  <Card>
    <h3>{MEDIA_CONTENT.seriesTitle}</h3>
    <p class="small">{MEDIA_CONTENT.seriesDescription}</p>
    <div class="links">
      {MEDIA_CONTENT.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.todo ? <TodoNote>{link.label}</TodoNote> : link.label}
        </a>
      ))}
    </div>
  </Card>
  {MEDIA_CONTENT.press.length > 0 && (
    <>
      <h2>Press &amp; Features</h2>
      {MEDIA_CONTENT.press.map((item) => (
        <EntryItem title={item.title} meta={`${item.outlet} · ${item.date}`}>
          {item.titleEn && <p class="small muted">{item.titleEn}</p>}
          <p class="small">{item.summary}</p>
          <div class="tags">
            <Tag variant="status">{item.kind}</Tag>
            <Tag>{item.language}</Tag>
          </div>
          <a
            class="small"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read on WeChat →
          </a>
        </EntryItem>
      ))}
    </>
  )}
  <p class="small muted">{MEDIA_CONTENT.editorialNote}</p>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .tags {
    margin: 6px 0;
  }
</style>
