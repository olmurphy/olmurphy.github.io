---
import { NAV_GROUPS, NAV_ITEMS } from "@config/site";
import { FEATURES } from "@config/features";
import { UI } from "@i18n/ui";
import type { Locale } from "@i18n/config";
import { localePath, switchLocalePath } from "@i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const ui = UI[lang];
const alternateLang: Locale = lang === "en" ? "zh" : "en";

const normalize = (path: string) =>
  path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;

const currentPath = normalize(Astro.url.pathname);
const switchHref = switchLocalePath(currentPath, alternateLang);

const visibleNavItems = NAV_ITEMS.filter(
  (item) => !item.featureFlag || FEATURES[item.featureFlag],
).map((item) => ({
  ...item,
  localizedLabel: ui.navLabels[item.href] ?? item.label,
  localizedHref: localePath(lang, item.href),
}));

const isCurrent = (href: string) => currentPath === normalize(href);

const mobileGroups = NAV_GROUPS.map((group) => ({
  label: ui.navGroups[group],
  items: visibleNavItems.filter((item) => item.group === group),
})).filter((group) => group.items.length > 0);

const desktopStartPins = visibleNavItems.filter(
  (item) => item.desktopPin && item.group === "Overview",
);
const desktopEndPins = visibleNavItems.filter(
  (item) => item.desktopPin && item.group !== "Overview",
);
const desktopDropdowns = NAV_GROUPS.map((group, idx) => {
  const items = visibleNavItems.filter(
    (item) => item.group === group && !item.desktopPin,
  );
  return {
    id: `dd-panel-${idx}`,
    label: ui.navGroups[group],
    items,
    hasActive: items.some((item) => isCurrent(item.localizedHref)),
  };
}).filter((group) => group.items.length > 0);
---

<nav class="desktop-nav" id="desktop-nav" aria-label={ui.primaryNavAria}>
  {desktopStartPins.map((item) => {
    const active = isCurrent(item.localizedHref);
    return (
      <a
        href={item.localizedHref}
        class:list={["nav-link", { active }]}
        aria-current={active ? "page" : undefined}
      >
        {item.localizedLabel}
      </a>
    );
  })}

  {desktopDropdowns.map((group) => (
    <div class="dd">
      <button
        type="button"
        class:list={["dd-trigger", { active: group.hasActive }]}
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls={group.id}
      >
        {group.label}
        <span class="caret" aria-hidden="true">
          ▼
        </span>
      </button>
      <div class="dd-panel" id={group.id}>
        {group.items.map((item) => {
          const active = isCurrent(item.localizedHref);
          return (
            <a
              href={item.localizedHref}
              class:list={[{ active }]}
              aria-current={active ? "page" : undefined}
            >
              {item.localizedLabel}
            </a>
          );
        })}
      </div>
    </div>
  ))}

  {desktopEndPins.map((item) => {
    const active = isCurrent(item.localizedHref);
    return (
      <a
        href={item.localizedHref}
        class:list={["nav-link", { active }]}
        aria-current={active ? "page" : undefined}
      >
        {item.localizedLabel}
      </a>
    );
  })}

  <div class="desktop-controls">
    <a
      href={switchHref}
      hreflang={alternateLang === "zh" ? "zh-Hans" : "en"}
      lang={alternateLang === "zh" ? "zh-Hans" : "en"}
      class="lang-toggle"
      aria-label={ui.languageSwitchAria}
    >
      {ui.languageSwitchLabel}
    </a>
    <ThemeToggle lang={lang} />
  </div>
</nav>

<nav class="mobile-menu" id="mobile-menu" aria-label={ui.mobileNavAria}>
  <div class="wrap menu-inner">
    {mobileGroups.map((group) => (
      <div class="group">
        <div class="group-label">{group.label}</div>
        {group.items.map((item) => {
          const active = isCurrent(item.localizedHref);
          return (
            <a
              href={item.localizedHref}
              class:list={[{ active }]}
              aria-current={active ? "page" : undefined}
            >
              {item.localizedLabel}
            </a>
          );
        })}
      </div>
    ))}

    <div class="menu-foot">
      <span>{ui.appearanceLabel}</span>
      <div class="mobile-controls">
        <a
          href={switchHref}
          hreflang={alternateLang === "zh" ? "zh-Hans" : "en"}
          lang={alternateLang === "zh" ? "zh-Hans" : "en"}
          class="lang-toggle"
          aria-label={ui.languageSwitchAria}
        >
          {ui.languageSwitchLabel}
        </a>
        <ThemeToggle lang={lang} />
      </div>
    </div>
  </div>
</nav>

<style>
  .desktop-nav {
    display: none;
  }

  /* ---------- Mobile drop-down panel ---------- */
  .mobile-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    max-height: calc(100vh - var(--header-height));
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
  }

  .mobile-menu.open {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .menu-inner {
    padding-top: 6px;
    padding-bottom: 18px;
  }

  .group-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 16px 0 4px;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 1.02rem;
  }

  .mobile-menu a::after {
    content: "›";
    color: var(--color-text-muted);
    font-size: 1.2rem;
    line-height: 1;
  }

  .mobile-menu a:hover {
    color: var(--color-accent);
  }

  .mobile-menu a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .mobile-menu a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .mobile-menu a.active::after {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .mobile-menu .group a:last-child {
    border-bottom: none;
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .mobile-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ---------- Desktop grouped dropdowns ---------- */
  @media (min-width: 760px) {
    .mobile-menu {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 20px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
    }

    .desktop-controls {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-left: auto;
      flex-shrink: 0;
    }

    .nav-link,
    .dd-trigger {
      color: var(--color-text-muted);
      padding: 8px 0 10px;
      border: none;
      border-bottom: 2px solid transparent;
      background: none;
      font: inherit;
      cursor: pointer;
      line-height: 1.5;
    }

    .nav-link:hover,
    .dd-trigger:hover {
      color: var(--color-text);
      border-bottom-color: var(--color-border);
    }

    .nav-link.active,
    .dd-trigger.active {
      color: var(--color-accent);
      border-bottom-color: var(--color-accent);
      font-weight: 600;
    }

    .nav-link:focus-visible,
    .dd-trigger:focus-visible,
    .dd-panel a:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .dd {
      position: relative;
    }

    .dd-trigger .caret {
      display: inline-block;
      margin-left: 5px;
      font-size: 0.65rem;
      transition: transform var(--transition-fast);
    }

    .dd.open .caret {
      transform: rotate(180deg);
    }

    .dd-panel {
      position: absolute;
      top: 100%;
      left: -12px;
      min-width: 230px;
      padding: 6px;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-4px);
      transition:
        opacity var(--transition-fast),
        transform var(--transition-fast),
        visibility var(--transition-fast);
    }

    .dd.open .dd-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .dd-panel a {
      display: block;
      padding: 8px 12px;
      border: none;
      border-radius: 6px;
      color: var(--color-text);
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .dd-panel a:hover {
      background: var(--color-accent-soft);
      color: var(--color-accent);
    }

    .dd-panel a.active {
      color: var(--color-accent);
      font-weight: 600;
      background: var(--color-accent-soft);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .dd-panel,
    .dd-trigger .caret {
      transition: none;
    }
  }
</style>

<script>
  const desktopNav = document.getElementById("desktop-nav");
  const hoverCapable = Boolean(
    window.matchMedia && window.matchMedia("(hover: hover)").matches,
  );
  let closeTimer: number | undefined;

  function closeAllDropdowns(except?: Element | null): void {
    desktopNav?.querySelectorAll<HTMLElement>(".dd.open").forEach((dd) => {
      if (dd === except) return;
      dd.classList.remove("open");
      dd.querySelector(".dd-trigger")?.setAttribute("aria-expanded", "false");
    });
  }

  function setDropdownOpen(dd: HTMLElement, open: boolean): void {
    window.clearTimeout(closeTimer);
    if (open) closeAllDropdowns(dd);
    dd.classList.toggle("open", open);
    dd.querySelector(".dd-trigger")?.setAttribute(
      "aria-expanded",
      String(open),
    );
  }

  desktopNav?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const trigger = target?.closest<HTMLButtonElement>(".dd-trigger");
    if (trigger) {
      const dd = trigger.closest<HTMLElement>(".dd");
      if (dd) setDropdownOpen(dd, !dd.classList.contains("open"));
      return;
    }

    if (target?.closest(".dd-panel a")) {
      closeAllDropdowns();
    }
  });

  desktopNav?.addEventListener("mouseover", (e) => {
    if (!hoverCapable) return;
    const target = e.target as HTMLElement | null;
    const dd = target?.closest<HTMLElement>(".dd");
    if (dd) setDropdownOpen(dd, true);
  });

  desktopNav?.addEventListener("mouseout", (e) => {
    if (!hoverCapable) return;
    const target = e.target as HTMLElement | null;
    const dd = target?.closest<HTMLElement>(".dd");
    const related = e.relatedTarget as Node | null;
    if (dd && !dd.contains(related)) {
      closeTimer = window.setTimeout(() => setDropdownOpen(dd, false), 140);
    }
  });

  desktopNav?.addEventListener("focusout", (e) => {
    const target = e.target as HTMLElement | null;
    const dd = target?.closest<HTMLElement>(".dd");
    const related = e.relatedTarget as Node | null;
    if (dd && !dd.contains(related)) {
      setDropdownOpen(dd, false);
    }
  });

  desktopNav?.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    const dd = target?.closest<HTMLElement>(".dd");
    if (!dd) return;

    const links = Array.from(
      dd.querySelectorAll<HTMLAnchorElement>(".dd-panel a"),
    );
    const trigger = dd.querySelector<HTMLButtonElement>(".dd-trigger");
    if (!trigger || links.length === 0) return;

    if (e.key === "Escape") {
      setDropdownOpen(dd, false);
      trigger.focus();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      setDropdownOpen(dd, true);
      const currentIdx = links.indexOf(
        document.activeElement as HTMLAnchorElement,
      );
      (links[currentIdx + 1] ?? links[0]).focus();
    } else if (e.key === "ArrowUp" && document.activeElement !== trigger) {
      e.preventDefault();
      const currentIdx = links.indexOf(
        document.activeElement as HTMLAnchorElement,
      );
      (currentIdx > 0 ? links[currentIdx - 1] : trigger).focus();
    }
  });

  document.addEventListener("click", (e) => {
    if (desktopNav && !desktopNav.contains(e.target as Node)) {
      closeAllDropdowns();
    }
  });
</script>
