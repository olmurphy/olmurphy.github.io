---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { PUBLICATIONS_CONTENT } from "@data/publications";
import { buildPublicationsJsonLd } from "@data/schema";
import PublicationItem from "@components/sections/publications/PublicationItem.astro";
---

<BaseLayout
  title={`Publications — ${SITE.name}`}
  description="Papers, preprints, and works in progress by Owen Li Murphy."
  jsonLd={buildPublicationsJsonLd()}
>
  {PUBLICATIONS_CONTENT.published.length > 0 && (
    <>
      <div class="pub-header">
        <div>
          <h1>{PUBLICATIONS_CONTENT.title}</h1>
          <p class="muted">{PUBLICATIONS_CONTENT.subtitle}</p>
        </div>
        <a
          href="/references.bib"
          download="references.bib"
          class="bibtex-master-btn small"
        >
          Download references.bib ↓
        </a>
      </div>
    </>
  )}

  {PUBLICATIONS_CONTENT.published.length > 0 && (
    <>
      <h2>Published &amp; accepted</h2>
      {PUBLICATIONS_CONTENT.published.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {PUBLICATIONS_CONTENT.underReview.length > 0 && (
    <>
      <h2>Under review</h2>
      {PUBLICATIONS_CONTENT.underReview.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {PUBLICATIONS_CONTENT.inProgress.length > 0 && (
    <>
      <h2>In progress</h2>
      {PUBLICATIONS_CONTENT.inProgress.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {PUBLICATIONS_CONTENT.talks.length > 0 && (
    <>
      <h2>Talks &amp; posters</h2>
      {PUBLICATIONS_CONTENT.talks.map((talk) => (
        <PublicationItem entry={talk} />
      ))}
    </>
  )}
</BaseLayout>

<style>
  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }

  .bibtex-master-btn {
    display: inline-block;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    font-family: var(--font-sans);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .bibtex-master-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-text-muted);
  }
</style>
