---
interface Props {
  title: string;
  meta?: string;
  logoSrc?: string;
  logoAlt?: string;
  logoHref?: string;
}

const { title, meta, logoSrc, logoAlt = "", logoHref } = Astro.props;
const fallbackInitials = logoAlt
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

<article class:list={["entry", { "has-logo": Boolean(logoSrc) }]}>
  {logoSrc && (
    <div class="logo-wrap">
      {logoHref ? (
        <a
          href={logoHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={logoAlt}
          class="logo-link"
        >
          <img src={logoSrc} alt={logoAlt} width="38" height="38" />
        </a>
      ) : (
        <img src={logoSrc} alt={logoAlt} width="38" height="38" />
      )}
    </div>
  )}

  <div class="entry-body">
    <h3>{title}</h3>
    {(meta || Astro.slots.has("meta")) && (
      <div class="meta">
        {meta}
        <slot name="meta" />
      </div>
    )}
    <slot />
  </div>
</article>

<style>
  .entry {
    margin-bottom: 22px;
  }

  .entry.has-logo {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .logo-wrap {
    width: 42px;
    height: 42px;
    margin-top: 2px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: #ffffff;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-link {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border: none;
  }

  .logo-link:hover {
    border: none;
  }

  .logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2px;
  }

  .logo-fallback {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }
</style>
