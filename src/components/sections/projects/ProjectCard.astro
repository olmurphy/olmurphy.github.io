---
import type { ProjectEntry } from "@data/projects";
import Card from "@components/ui/Card.astro";
import Tag from "@components/ui/Tag.astro";
import TodoNote from "@components/ui/TodoNote.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
---

<Card>
  <h3>{project.title}</h3>
  <div class="meta">
    {project.statusTag && <Tag variant="status">{project.statusTag}</Tag>}
    {project.tags.map((tag) => (
      <Tag>{tag}</Tag>
    ))}
    {project.metaTodo && <TodoNote>{project.metaTodo}</TodoNote>}
  </div>
  <p class="small">{project.summary}</p>
  {project.linkHref && project.linkLabel && (
    <a class="small" href={project.linkHref}>
      {project.linkTodo ? (
        <TodoNote>{project.linkLabel}</TodoNote>
      ) : (
        project.linkLabel
      )}
    </a>
  )}
</Card>

<style>
  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 4px;
  }
</style>
