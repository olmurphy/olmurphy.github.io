---
import { SITE } from "@config/site";

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    © {year} {SITE.name}
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 20px 0 40px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }
</style>
