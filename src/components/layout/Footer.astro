---
import { SITE } from "@config/site";
import { SOCIAL_LINKS, PROFESSIONAL_LINKS } from "@data/profile";

const year = new Date().getFullYear();

const columns = [
  { title: "Social", links: SOCIAL_LINKS },
  { title: "Professional", links: PROFESSIONAL_LINKS },
];
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="brand">
        <a class="brand-name" href="/">
          {SITE.name}
        </a>
        <p class="brand-tagline">{SITE.tagline}</p>
      </div>

      {columns.map((col) => (
        <nav
          class="footer-col"
          aria-labelledby={`footer-${col.title.toLowerCase()}`}
        >
          <h2 id={`footer-${col.title.toLowerCase()}`}>{col.title}</h2>
          <ul>
            {col.links.map((link) => {
              const isExternal = link.href.startsWith("http");
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      © {year} {SITE.name}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 48px 0 72px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: 32px 48px;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    border: none;
  }

  .brand-name:hover {
    border: none;
  }

  .brand-tagline {
    margin: 6px 0 0;
    max-width: 28ch;
    line-height: 1.5;
  }

  /* Overrides the global h2 style (rule, margins) so column titles stay small and quiet */
  .footer-col h2 {
    margin: 0 0 14px;
    padding: 0;
    border: none;
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col li {
    margin: 0 0 10px;
  }

  .footer-col a {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .footer-col a:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text-muted);
  }

  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 600px) {
    footer {
      padding: 40px 0 56px;
    }

    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
