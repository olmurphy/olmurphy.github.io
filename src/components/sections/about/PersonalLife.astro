---
import { getContent } from "@data";
import { getLocaleFromPath, localePath } from "@i18n/utils";
import { UI } from "@i18n/ui";
import KeyValueTable from "@components/ui/KeyValueTable.astro";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang).about;
const labels = UI[lang].labels;
---

<section aria-label={labels.personalInterests}>
  <h2>{content.outsideLabHeading}</h2>
  <ul>
    {content.outsideLabItems.map((item) => (
      <li>
        {item.text}
        {item.linkHref && item.linkLabel && (
          <a href={localePath(lang, item.linkHref)}>{item.linkLabel}</a>
        )}
        {item.suffix}
      </li>
    ))}
  </ul>

  <h2>{content.quickFactsHeading}</h2>
  <KeyValueTable rows={content.quickFacts} />
</section>
