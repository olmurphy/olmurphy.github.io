---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { getContent } from "@data";
import { buildPublicationsJsonLd } from "@data/schema";
import { getLocaleStaticPaths, type Locale } from "@i18n/config";
import { UI } from "@i18n/ui";
import { localePath } from "@i18n/utils";
import PublicationItem from "@components/sections/publications/PublicationItem.astro";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { lang } = Astro.props as { lang: Locale };
const content = getContent(lang).publications;
const labels = UI[lang].labels;
---

<BaseLayout
  lang={lang}
  title={
    lang === "en" ? `Publications — ${SITE.name}` : `论文发表 — ${SITE.name}`
  }
  description={
    lang === "en"
      ? "Papers, preprints, and works in progress by Owen Li Murphy."
      : "Owen Li Murphy 已发表论文、预印本与进行中的研究成果。"
  }
  jsonLd={buildPublicationsJsonLd(lang)}
>
  {content.published.length > 0 && (
    <>
      <div class="pub-header">
        <div>
          <h1>{content.title}</h1>
          <p class="muted">{content.subtitle}</p>
        </div>
        <a
          href={localePath(lang, "/references.bib")}
          download="references.bib"
          class="bibtex-master-btn small"
        >
          {labels.publicationsBibtex}
        </a>
      </div>
    </>
  )}

  {content.published.length > 0 && (
    <>
      <h2>{labels.publicationsPublished}</h2>
      {content.published.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {content.underReview.length > 0 && (
    <>
      <h2>{labels.publicationsReview}</h2>
      {content.underReview.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {content.inProgress.length > 0 && (
    <>
      <h2>{labels.publicationsProgress}</h2>
      {content.inProgress.map((paper) => (
        <PublicationItem entry={paper} />
      ))}
    </>
  )}

  {content.talks.length > 0 && (
    <>
      <h2>{labels.publicationsTalks}</h2>
      {content.talks.map((talk) => (
        <PublicationItem entry={talk} />
      ))}
    </>
  )}
</BaseLayout>

<style>
  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 8px;
  }

  .bibtex-master-btn {
    display: inline-block;
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    border-radius: var(--radius-pill);
    padding: 4px 14px;
    font-family: var(--font-sans);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .bibtex-master-btn:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
    background: var(--color-surface-subtle);
    border-bottom: 1px solid var(--color-text-muted);
  }
</style>
