---
import { getContent } from "@data";
import { getLocaleFromPath } from "@i18n/utils";
import { UI } from "@i18n/ui";
import Tag from "@components/ui/Tag.astro";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang).research;
const labels = UI[lang].labels;
---

<section aria-label={labels.researchDirections}>
  <h2>{labels.statement}</h2>
  <p>{content.statement}</p>

  <h2>{labels.currentDirections}</h2>
  <ul>
    {content.directions.map((item) => (
      <li>
        <strong>{item.title}</strong> — {item.description}
      </li>
    ))}
  </ul>

  <h2>{labels.exploringAreas}</h2>
  <p class="tag-list">
    {content.exploringAreas.map((area) => (
      <Tag>{area}</Tag>
    ))}
  </p>
</section>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
  }
</style>
