---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { FEATURES } from "@config/features";
import { PROJECTS_CONTENT, type ProjectEntry } from "@data/projects";
import ProjectCard from "@components/sections/projects/ProjectCard.astro";
import TodoNote from "@components/ui/TodoNote.astro";

const isVisible = (entry: ProjectEntry) =>
  !entry.featureFlag || FEATURES[entry.featureFlag];

const visibleProjects = PROJECTS_CONTENT.projects.filter(isVisible);
const visibleHackathons = PROJECTS_CONTENT.hackathons.filter(isVisible);
---

<BaseLayout
  title={`Projects — ${SITE.name}`}
  description="Research and software engineering projects by Owen Li Murphy."
>
  <h1>{PROJECTS_CONTENT.title}</h1>
  <p class="muted">{PROJECTS_CONTENT.subtitle}</p>

  <h2 class="first-heading">Projects</h2>
  {visibleProjects.map((project) => (
    <ProjectCard project={project} />
  ))}

  <h2>Hackathons</h2>
  {visibleHackathons.map((hackathon) => (
    <ProjectCard project={hackathon} />
  ))}
  <p class="small muted">
    <TodoNote>{PROJECTS_CONTENT.hackathonPromptTodo}</TodoNote>
  </p>

  <p class="small muted">
    Tip: pick your 3–5 best and give each a one-line takeaway, plus a link to
    code or a write-up. For a research portfolio, quality and clarity matter
    more than quantity.
  </p>
</BaseLayout>

<style>
  .first-heading {
    margin-top: 22px;
  }
</style>
