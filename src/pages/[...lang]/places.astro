---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getContent } from "@data";
import { LOCALES, type Locale } from "@i18n/config";
import PlacesExplorer from "@components/sections/places/PlacesExplorer.astro";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang: lang === "en" ? undefined : lang },
    props: { lang },
  }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = getContent(lang).places;
---

<BaseLayout
  title={`${content.title} — Owen Li Murphy`}
  description={content.subtitle}
  lang={lang}
>
  <h1>{content.title}</h1>
  <p class="muted">{content.subtitle}</p>
  <PlacesExplorer content={content} />
</BaseLayout>
