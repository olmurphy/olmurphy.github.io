---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { EDUCATION_CONTENT } from "@data/education";
import EntryItem from "@components/ui/EntryItem.astro";
import SkillRow from "@components/sections/education/SkillRow.astro";
---

<BaseLayout
  title={`Education & Experience — ${SITE.name}`}
  description="Academic degrees, software engineering experience, honors, and technical skills of Owen Li Murphy."
>
  <h1>{EDUCATION_CONTENT.title}</h1>

  <h2>Education</h2>
  {EDUCATION_CONTENT.education.map((edu) => (
    <EntryItem
      title={edu.degree}
      logoSrc={edu.logoSrc}
      logoAlt={edu.institution}
      logoHref={edu.institutionHref}
    >
      <Fragment slot="meta">
        <a href={edu.institutionHref} target="_blank" rel="noopener noreferrer">
          {edu.institution}
        </a>
        {edu.institutionSuffix} · {edu.period}
      </Fragment>
      {edu.details && <p class="small">{edu.details}</p>}
    </EntryItem>
  ))}

  {EDUCATION_CONTENT.visiting.length > 0 && (
    <>
      <h2>Visiting Appointments</h2>
      {EDUCATION_CONTENT.visiting.map((visit) => (
        <EntryItem
          title={visit.role}
          logoSrc={visit.logoSrc}
          logoAlt={visit.institution}
          logoHref={visit.institutionHref}
        >
          <Fragment slot="meta">
            <a
              href={visit.institutionHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {visit.institution}
            </a>
            {visit.institutionNote}
            {visit.hosts && visit.hosts.length > 0 && (
              <>
                {" "}
                · Collaborators:{" "}
                {visit.hosts.map((host, idx) => (
                  <>
                    {idx > 0 && " & "}
                    {host.href ? (
                      <a
                        href={host.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {host.name}
                      </a>
                    ) : (
                      host.name
                    )}
                  </>
                ))}
              </>
            )}{" "}
            ·{" "}
            {visit.todo ? (
              <span class="todo">{visit.period}</span>
            ) : (
              visit.period
            )}
          </Fragment>
          {visit.summary && (
            <p class:list={["small", { todo: visit.todo }]}>{visit.summary}</p>
          )}
        </EntryItem>
      ))}
    </>
  )}

  <h2>Experience</h2>
  {EDUCATION_CONTENT.experience.map((exp) => (
    <EntryItem title={exp.role} meta={`${exp.company} · ${exp.dates}`}>
      <p class="small">{exp.summary}</p>
    </EntryItem>
  ))}

  <h2>Awards &amp; Honors</h2>
  {EDUCATION_CONTENT.awards.map((award) => (
    <EntryItem title={award.title} meta={`${award.issuer} · ${award.date}`}>
      {award.description && <p class="small">{award.description}</p>}
    </EntryItem>
  ))}

  <h2>Skills</h2>
  {EDUCATION_CONTENT.skills.map((skill) => (
    <SkillRow skill={skill} />
  ))}
</BaseLayout>
