---
import { getContent } from "@data";
import { getLocaleFromPath } from "@i18n/utils";
import { UI } from "@i18n/ui";
import EntryItem from "@components/ui/EntryItem.astro";
import TodoNote from "@components/ui/TodoNote.astro";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang).research;
const labels = UI[lang].labels;
---

<section aria-labelledby="grants-heading">
  <h2 id="grants-heading">{labels.grants}</h2>
  {content.grants.length > 0 ? (
    content.grants.map((grant) => (
      <EntryItem
        title={grant.title}
        meta={[grant.funder, grant.date, grant.amountOrRole]
          .filter(Boolean)
          .join(" · ")}
      >
        {grant.description && <p class="small">{grant.description}</p>}
      </EntryItem>
    ))
  ) : (
    <p class="muted">
      <TodoNote>{content.grantsEmptyTodo}</TodoNote>
    </p>
  )}
</section>
