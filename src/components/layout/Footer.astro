---
import { SITE } from "@config/site";
import { getContent } from "@data";
import { UI } from "@i18n/ui";
import type { Locale } from "@i18n/config";
import { localePath } from "@i18n/utils";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const year = new Date().getFullYear();
const ui = UI[lang];
const content = getContent(lang);
const columns = [
  { title: ui.footerSocialHeading, links: content.socialLinks },
  { title: ui.footerProfessionalHeading, links: content.professionalLinks },
];
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="brand">
        <a class="brand-name" href={localePath(lang, "/")}>
          {ui.siteName}
        </a>
        <p class="brand-tagline">{ui.tagline}</p>
      </div>

      {columns.map((col) => (
        <nav
          class="footer-col"
          aria-labelledby={`footer-${col.title.toLowerCase()}`}
        >
          <h2 id={`footer-${col.title.toLowerCase()}`}>{col.title}</h2>
          <ul>
            {col.links.map((link, idx) => {
              if ("qrSrc" in link && link.qrSrc) {
                const popupId = `qr-popup-${idx}`;
                return (
                  <li class="qr-item">
                    <button
                      type="button"
                      class="qr-trigger"
                      aria-expanded="false"
                      aria-controls={popupId}
                    >
                      {link.label}
                    </button>
                    <div
                      class="qr-popup"
                      id={popupId}
                      role="group"
                      aria-label={link.label}
                    >
                      <img
                        src={link.qrSrc}
                        alt={
                          ("qrAlt" in link ? link.qrAlt : undefined) ??
                          link.label
                        }
                        width="140"
                        height="140"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>{ui.scanWithWechat}</span>
                    </div>
                  </li>
                );
              }
              const isExternal = link.href?.startsWith("http");
              return (
                <li>
                  <a
                    href={link.href}
                    target={isExternal ? "_blank" : undefined}
                    rel={isExternal ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))}
    </div>

    <div class="footer-bottom">
      © {year} {SITE.name}
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: 48px 0 72px;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    gap: 32px 48px;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    border: none;
  }

  .brand-name:hover {
    border: none;
  }

  .brand-tagline {
    margin: 6px 0 0;
    max-width: 28ch;
    line-height: 1.5;
  }

  /* Overrides the global h2 style (rule, margins) so column titles stay small and quiet */
  .footer-col h2 {
    margin: 0 0 14px;
    padding: 0;
    border: none;
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col li {
    margin: 0 0 10px;
  }

  .footer-col a {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .footer-col a:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text-muted);
  }
  .qr-item {
    position: relative;
  }

  .qr-trigger {
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0;
    font: inherit;
    font-size: var(--text-base);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .qr-trigger:hover,
  .qr-trigger:focus-visible {
    color: var(--color-text);
    border-bottom-color: var(--color-text-muted);
  }

  .qr-popup {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    z-index: 10;
    width: 168px;
    padding: 14px;
    /* Always white so the code scans reliably in dark mode */
    background: #ffffff;
    color: #1f2328;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    text-align: center;
    font-size: var(--text-xs);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  /* Invisible bridge so the popup doesn't close while the pointer crosses the gap */
  .qr-popup::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
  }

  .qr-popup img {
    display: block;
    width: 140px;
    height: 140px;
    margin: 0 auto 8px;
  }

  .qr-item:hover .qr-popup,
  .qr-item:focus-within .qr-popup,
  .qr-item.open .qr-popup {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .qr-popup {
      transition: none;
      transform: none;
    }
  }

  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 600px) {
    footer {
      padding: 40px 0 56px;
    }

    .footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .brand {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const qrItems = Array.from(
    document.querySelectorAll<HTMLElement>(".qr-item"),
  );

  function closeAll(): void {
    qrItems.forEach((item) => {
      item.classList.remove("open");
      item.querySelector(".qr-trigger")?.setAttribute("aria-expanded", "false");
    });
  }

  qrItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".qr-trigger");
    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const willOpen = !item.classList.contains("open");
      closeAll();
      item.classList.toggle("open", willOpen);
      trigger.setAttribute("aria-expanded", String(willOpen));
    });
  });

  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
</script>
