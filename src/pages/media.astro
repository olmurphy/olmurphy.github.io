---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE } from "@config/site";
import { MEDIA_CONTENT } from "@data/media";
import Card from "@components/ui/Card.astro";
import Tag from "@components/ui/Tag.astro";
import TodoNote from "@components/ui/TodoNote.astro";
---

<BaseLayout
  title={`Media — ${SITE.name}`}
  description="Educational videos, viral talks, and science communication by Owen Li Murphy."
>
  <h1>{MEDIA_CONTENT.title}</h1>
  <p class="muted">{MEDIA_CONTENT.subtitle}</p>

  <h2>Featured Talks &amp; Presentations</h2>
  {MEDIA_CONTENT.featuredTalks.map((talk) => (
    <Card>
      <h3>{talk.title}</h3>
      <div class="meta">
        <Tag variant="status">{talk.platform}</Tag>
        <Tag>{talk.stats}</Tag>
      </div>
      <p class="small">{talk.description}</p>
      <div class="links" style="margin-top: 10px;">
        <a
          href="https://www.douyin.com/user/self?from_tab_name=main&modal_id=7620062047056743731"
          target="_blank"
          rel="noopener noreferrer"
          class="small"
        >
          Watch on Douyin →
        </a>
        &nbsp;&nbsp;
        <a
          href="https://www.rednote.com/discovery/item/69bfe738000000002102d1bc?xsec_token=AB9Ejr8SjTOOD2pcwT1TlkptUKg7ctoh3UIVzn6vcEFAk=&xsec_source=pc_user"
          target="_blank"
          rel="noopener noreferrer"
          class="small"
        >
          Watch on Xiaohongshu →
        </a>
      </div>
    </Card>
  ))}

  <h2>Series</h2>
  <Card>
    <h3>{MEDIA_CONTENT.seriesTitle}</h3>
    <p class="small">{MEDIA_CONTENT.seriesDescription}</p>
    <div class="links">
      {MEDIA_CONTENT.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.todo ? <TodoNote>{link.label}</TodoNote> : link.label}
        </a>
      ))}
    </div>
  </Card>

  <p class="small muted">{MEDIA_CONTENT.editorialNote}</p>
</BaseLayout>

<style>
  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
</style>
