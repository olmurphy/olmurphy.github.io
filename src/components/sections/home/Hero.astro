---
import { getContent } from "@data";
import { getLocaleFromPath } from "@i18n/utils";

const lang = getLocaleFromPath(Astro.url.pathname);
const content = getContent(lang);
---

<section class="hero" aria-label={lang === "en" ? "Introduction" : "个人简介"}>
  <div class="portrait">
    <img
      src={content.home.hero.portraitSrc}
      alt={content.home.hero.portraitAlt}
      onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
    />
    <span class="todo" style="display: none;">
      {lang === "en"
        ? content.home.hero.portraitPlaceholder
        : "请添加 photo.jpg"}
    </span>
  </div>

  <div class="hero-text">
    <h1>Owen Li Murphy</h1>
    <p class="muted subtitle">
      {content.home.hero.affiliation} &nbsp;·&nbsp; 李晓党
    </p>
    <p set:html={content.home.hero.bioHtml} />

    <div class="links">
      {content.profileLinks.map((link) => (
        <a href={link.href} class:list={[{ todo: link.todo }]}>
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .portrait {
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-align: center;
    flex-shrink: 0;
    font-family: var(--font-sans);
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .hero-text {
    flex: 1;
    min-width: 260px;
  }

  .subtitle {
    margin-bottom: 10px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 6px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .hero {
      flex-direction: column;
      align-items: center;
    }

    .hero-text {
      width: 100%;
      min-width: 0;
    }

    .hero-text h1,
    .subtitle {
      text-align: center;
    }
  }
</style>
